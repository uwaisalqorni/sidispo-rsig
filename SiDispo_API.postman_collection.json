{
  "info": {
    "name": "SiDispo API — Sistem Disposisi Digital",
    "_postman_id": "sidispo-api-collection-v1",
    "description": "Koleksi API lengkap untuk SiDispo (Sistem Disposisi Digital).\n\n**Backend:** CodeIgniter 3 + JWT Auth\n**Base URL:** {{base_url}}/api/v1\n\n**Cara Pakai:**\n1. Set variable `base_url` di Environment\n2. Jalankan request `Login` dulu\n3. Token JWT otomatis tersimpan ke variable `token`\n4. Semua request lain otomatis pakai token\n\n**Akun Test (password: Sidispo@2026):**\n- Direktur: direktur@rsud.go.id\n- Kabid Keuangan: kabid.keu@rsud.go.id\n- Kabid Keperawatan: kabid.kep@rsud.go.id\n- Admin: admin@rsud.go.id",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "http://localhost/sidispo-backend", "type": "string" },
    { "key": "token",         "value": "", "type": "string" },
    { "key": "disposisi_id",  "value": "1", "type": "string" },
    { "key": "penerima_id",   "value": "1", "type": "string" },
    { "key": "folder_id",     "value": "1", "type": "string" },
    { "key": "surat_id",      "value": "1", "type": "string" },
    { "key": "notif_id",      "value": "1", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login — Direktur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.status === 'success' && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    pm.test('Login berhasil & token tersimpan', () => pm.expect(res.status).to.eql('success'));",
                  "    console.log('Token:', res.data.token);",
                  "} else {",
                  "    pm.test('Login gagal', () => pm.expect(res.status).to.eql('success'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"direktur@rsud.go.id\",\n  \"password\": \"Sidispo@2026\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] },
            "description": "Login sebagai Direktur. Token JWT otomatis tersimpan ke variable `token`."
          }
        },
        {
          "name": "Login — Kabid Keuangan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.status === 'success' && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    pm.test('Login Kabid Keuangan berhasil', () => pm.expect(res.status).to.eql('success'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kabid.keu@rsud.go.id\",\n  \"password\": \"Sidispo@2026\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "Login — Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.status === 'success' && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    pm.test('Login Admin berhasil', () => pm.expect(res.status).to.eql('success'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@rsud.go.id\",\n  \"password\": \"Sidispo@2026\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "Get Profile (Me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Ada data user', () => pm.expect(res.data).to.have.property('nama_lengkap'));",
                  "console.log('User:', res.data.nama_lengkap, '|', res.data.role);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/auth/me", "host": ["{{base_url}}"], "path": ["api","v1","auth","me"] },
            "description": "Ambil data user yang sedang login berdasarkan token."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api","v1","auth","logout"] }
          }
        },
        {
          "name": "[❌ NEGATIF] Login Password Salah",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Harus return 401', () => pm.response.to.have.status(401));",
                  "const res = pm.response.json();",
                  "pm.test('Ada pesan error', () => pm.expect(res.status).to.eql('error'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"direktur@rsud.go.id\",\n  \"password\": \"password_salah\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "[❌ NEGATIF] Akses Tanpa Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Harus return 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/disposisi", "host": ["{{base_url}}"], "path": ["api","v1","disposisi"] }
          }
        }
      ]
    },

    {
      "name": "📊 Dashboard",
      "item": [
        {
          "name": "Get Stats Dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Ada statistik', () => {",
                  "    pm.expect(res.data).to.have.property('total_aktif');",
                  "    pm.expect(res.data).to.have.property('total_selesai');",
                  "    pm.expect(res.data).to.have.property('total_overdue');",
                  "});",
                  "console.log('Stats:', JSON.stringify(res.data, null, 2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/dashboard", "host": ["{{base_url}}"], "path": ["api","v1","dashboard"] },
            "description": "Statistik ringkasan untuk dashboard: total aktif, selesai, overdue, diproses, progress per unit."
          }
        }
      ]
    },

    {
      "name": "📋 Disposisi",
      "item": [
        {
          "name": "Get Semua Disposisi",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Ada array data', () => pm.expect(res.data).to.be.an('array'));",
                  "if (res.data.length > 0) {",
                  "    pm.collectionVariables.set('disposisi_id', res.data[0].id);",
                  "    console.log('Total disposisi:', res.data.length);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/disposisi",
              "host": ["{{base_url}}"],
              "path": ["api","v1","disposisi"],
              "query": [
                { "key": "status", "value": "", "description": "Filter: AKTIF | SELESAI | ARSIP", "disabled": true },
                { "key": "folder_id", "value": "", "description": "Filter by folder ID", "disabled": true },
                { "key": "prioritas", "value": "", "description": "Filter: URGENT | NORMAL | BIASA", "disabled": true },
                { "key": "dari_tanggal", "value": "", "description": "Filter dari tanggal (Y-m-d)", "disabled": true },
                { "key": "sampai_tanggal", "value": "", "description": "Filter sampai tanggal (Y-m-d)", "disabled": true },
                { "key": "keyword", "value": "", "description": "Search keyword perihal/nomor", "disabled": true },
                { "key": "per_page", "value": "10", "description": "Jumlah per halaman", "disabled": true },
                { "key": "page", "value": "1", "description": "Halaman", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Disposisi — Filter Status AKTIF",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/disposisi?status=AKTIF",
              "host": ["{{base_url}}"],
              "path": ["api","v1","disposisi"],
              "query": [{ "key": "status", "value": "AKTIF" }]
            }
          }
        },
        {
          "name": "Get Disposisi — Filter URGENT",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/disposisi?prioritas=URGENT",
              "host": ["{{base_url}}"],
              "path": ["api","v1","disposisi"],
              "query": [{ "key": "prioritas", "value": "URGENT" }]
            }
          }
        },
        {
          "name": "Get Disposisi Overdue",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Semua overdue', () => {",
                  "    res.data.forEach(d => pm.expect(d.sisa_hari).to.be.below(0));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/disposisi/overdue", "host": ["{{base_url}}"], "path": ["api","v1","disposisi","overdue"] }
          }
        },
        {
          "name": "Get Statistik Disposisi",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/disposisi/stats", "host": ["{{base_url}}"], "path": ["api","v1","disposisi","stats"] }
          }
        },
        {
          "name": "Get Detail Disposisi",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Ada detail lengkap', () => {",
                  "    pm.expect(res.data).to.have.property('nomor_disposisi');",
                  "    pm.expect(res.data).to.have.property('isi_disposisi');",
                  "    pm.expect(res.data).to.have.property('penerima');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/disposisi/{{disposisi_id}}", "host": ["{{base_url}}"], "path": ["api","v1","disposisi","{{disposisi_id}}"] }
          }
        },
        {
          "name": "Buat Disposisi Baru",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test('Disposisi berhasil dibuat', () => pm.expect(res.status).to.eql('success'));",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('disposisi_id', res.data.id);",
                  "    console.log('Disposisi baru ID:', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"surat_masuk_id\": 1,\n  \"folder_id\": 7,\n  \"isi_disposisi\": \"Segera tindaklanjuti edaran ini. Koordinasikan dengan semua unit terkait dan laporkan hasilnya dalam 7 hari kerja.\",\n  \"prioritas\": \"URGENT\",\n  \"batas_waktu\": \"2026-03-01\",\n  \"catatan_direktur\": \"Pastikan tidak ada yang terlewat.\",\n  \"penerima\": [6, 5]\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/disposisi", "host": ["{{base_url}}"], "path": ["api","v1","disposisi"] },
            "description": "Buat disposisi baru. Field `penerima` adalah array user_id."
          }
        },
        {
          "name": "Update Disposisi",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isi_disposisi\": \"Update instruksi: Tambahkan koordinasi dengan Bagian Perencanaan sebelum eksekusi.\",\n  \"prioritas\": \"NORMAL\",\n  \"batas_waktu\": \"2026-03-05\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/disposisi/{{disposisi_id}}", "host": ["{{base_url}}"], "path": ["api","v1","disposisi","{{disposisi_id}}"] }
          }
        },
        {
          "name": "Arsipkan Disposisi",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/v1/disposisi/{{disposisi_id}}", "host": ["{{base_url}}"], "path": ["api","v1","disposisi","{{disposisi_id}}"] }
          }
        },
        {
          "name": "[❌ NEGATIF] Buat Disposisi — Field Kosong",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Harus return 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"surat_masuk_id\": 1\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/disposisi", "host": ["{{base_url}}"], "path": ["api","v1","disposisi"] }
          }
        },
        {
          "name": "[❌ NEGATIF] Buat Disposisi — Role STAF",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Harus return 403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"surat_masuk_id\": 1,\n  \"isi_disposisi\": \"Test oleh staf\",\n  \"penerima\": [6]\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/disposisi", "host": ["{{base_url}}"], "path": ["api","v1","disposisi"] },
            "description": "Ganti token ke akun STAF sebelum jalankan ini."
          }
        }
      ]
    },

